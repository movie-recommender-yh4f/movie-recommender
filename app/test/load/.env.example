# Copy values into the current PowerShell environment; this file is not auto-loaded.

# Target safety
BASE_URL=https://your-load-test-deployment.example
PRODUCTION_HOSTS=your-production-host.example
LOAD_TEST_TOKEN=secret_matching_NUXT_LOAD_TEST_TOKEN
ALLOW_PRODUCTION_LOAD_TEST=false

# Authentication used by k6 (service-role keys are forbidden here)
LOAD_TEST_SUPABASE_URL=https://your-test-project.supabase.co
LOAD_TEST_SUPABASE_ANON_KEY=your_test_anon_key
LOAD_TEST_ACCOUNTS_FILE=../data/accounts.json

# Local-only test-user administration
LOAD_TEST_SUPABASE_SERVICE_ROLE_KEY=local_only_service_role_key
LOAD_TEST_EXPECTED_PROJECT_REF=your_test_project_ref
PRODUCTION_SUPABASE_PROJECT_REFS=your_production_project_ref
LOAD_TEST_USER_COUNT=30
LOAD_TEST_USER_PREFIX=nextwatch-loadtest
LOAD_TEST_USER_EMAIL_DOMAIN=example.invalid
LOAD_TEST_USER_PASSWORD=generate_a_unique_secret_password
LOAD_TEST_ACCOUNT_FILE=test/load/data/accounts.json
LOAD_TEST_WATCHED_TMDB_IDS=550,680,155,13,122
LOAD_TEST_DELETE_CONFIRMATION=

# Common workload data
MOVIE_IDS=550,680,155,13
SEARCH_TERMS=matrix,arrival,godfather
THINK_TIME_SECONDS=1
LOAD_TEST_MUTATION_MOVIE_ID=603
WARM_MOVIE_ID=550
COLD_MOVIE_IDS=
STAMPEDE_MOVIE_ID=
INVALID_MOVIE_ID=2147483647

# Profile sizing
SMOKE_VUS=1
SMOKE_DURATION=30s
BROWSE_VUS=5
BROWSE_DURATION=2m
AUTHENTICATED_VUS=5
AUTHENTICATED_DURATION=2m
MIXED_VUS=10
MIXED_DURATION=5m
SPIKE_BASE_VUS=2
SPIKE_MAX_VUS=20
SPIKE_RAMP_DURATION=15s
SPIKE_HOLD_DURATION=30s
STRESS_LEVELS=5,10,20,30
AUTH_STRESS_LEVELS=5,10,20,30
AUTH_STRESS_STAGE_DURATION=1m
AUTH_STRESS_P95_MS_THRESHOLD=2000
MIXED_STRESS_LEVELS=5,10,20,30
MIXED_STRESS_STAGE_DURATION=1m
MIXED_STRESS_P95_MS_THRESHOLD=2000
SOAK_VUS=5
SOAK_DURATION=20m
RECOMMENDATION_VUS=5
RECOMMENDATION_ITERATIONS_PER_VU=1
RECOMMENDATION_DURATION=1m

# Explicit higher-risk overrides
ALLOW_LONG_SMOKE=false
ALLOW_LONG_BROWSE=false
ALLOW_LONG_AUTHENTICATED=false
ALLOW_LONG_MIXED=false
ALLOW_LONG_SPIKE=false
ALLOW_HIGH_VU_COUNT=false
ALLOW_LONG_AUTH_STRESS=false
ALLOW_LONG_MIXED_STRESS=false
ALLOW_LONG_SOAK=false
ALLOW_LONG_RECOMMENDATIONS=false

# Mock recommendation verification
EXPECTED_AI_PROVIDER_MODE=mock
EXPECTED_MOCK_SCENARIO=success-normal
EXPECTED_RECOMMENDATION_STATUSES=200

# Strictly capped real OpenRouter test
ALLOW_REAL_AI_TEST=false
REAL_AI_CONFIRMATION=
REAL_AI_REQUESTS=1
MAX_REAL_AI_REQUESTS=5
REAL_AI_VUS=1
ALLOW_REAL_AI_CONCURRENCY=false

# Single signup request; may consume one email
ALLOW_SIGNUP_TEST=false
SIGNUP_EMAIL_PREFIX=nextwatch-loadtest-
SIGNUP_EMAIL=
SIGNUP_PASSWORD=
SIGNUP_USERNAME=
HCAPTCHA_TEST_TOKEN=
EXPECT_DUPLICATE_SIGNUP=false

# Result metadata; never put secrets here
DEPLOYMENT_REGION=
LOAD_GENERATOR_REGION=
VERCEL_PLAN=
SUPABASE_PLAN=
REDIS_PLAN=
CACHE_STATE_NOTES=
TEST_ASSUMPTIONS=
